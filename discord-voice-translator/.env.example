# Copy to .env (local / docker compose) or add these as Variables in Railway.
# Never commit real values.

# --- Discord (required) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Register slash commands only in this server while testing (faster); leave empty for global
DEV_GUILD_ID=

# --- Fast cloud pipeline (recommended) ---
# With SONIOX_API_KEY set and WORKER_URLS unset, the bot runs the fast pipeline
# (Soniox speech-to-text + translation, ElevenLabs voice) inside this one service.
PIPELINE=cloud
SONIOX_API_KEY=
ELEVENLABS_API_KEY=
# Optional
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_flash_v2_5
# SONIOX_MODEL=stt-rt-v6
# Languages people are expected to speak (helps recognition); Tagalog + English by default
# DEFAULT_SPOKEN_LANGS=tl,en

# --- Web companion (/listen) ---
# Public https URL of this service (Railway: Settings -> Networking -> Generate Domain)
PUBLIC_URL=

# --- Self-hosted Python worker (old pipeline; only if PIPELINE=worker) ---
# WORKER_URLS=worker:7700
# WORKER_TOKEN=

# --- Misc ---
# DB_PATH=/data/edge.sqlite
# LOG_LEVEL=info
