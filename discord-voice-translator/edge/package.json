{
  "name": "dvt-edge",
  "version": "1.0.0",
  "description": "Discord voice edge for the live voice translation bot (DAVE-capable @discordjs/voice)",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "node dist/main.js",
    "start:sharded": "node dist/shard-manager.js",
    "dev": "tsx src/main.ts",
    "register": "node dist/register-commands.js",
    "dave-spike": "node dist/dave-spike.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "prism-media": "^1.3.5",
    "ws": "^8.18.3"
  },
  "optionalDependencies": {
    "opusscript": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@snazzah/davey": "^0.1.12"
  }
}
